# Настройки для docker compose. Скопируйте в .env и заполните.

# Токен бота от @BotFather
TG_BOT_TOKEN=
# Общий секрет, которым бот и админка ходят в API — любая длинная случайная строка
API_TOKEN=
# Пароль базы
DB_PASSWORD=
# Публичный HTTPS-адрес бота: ссылки из сообщений /c/…, страница видео /w/…, хук оплаты
PUBLIC_URL=https://bot.example.com
# Секрет хука оплаты GetCourse: /hooks/gc/payment?secret=…
HOOK_SECRET=
# Владелец админки — создаётся при первом запуске; пароль потом меняется в «Настройках»
OWNER_LOGIN=admin
OWNER_PASSWORD=
OWNER_TG_ID=
# Telegram id админов бота (/test, /offer, /paid, /stats, /reset), через запятую
ADMIN_TG_IDS=
