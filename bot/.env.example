TG_BOT_TOKEN=
# Адрес API с данными и общий секрет
API_URL=http://127.0.0.1:3014
API_TOKEN=
# Публичный HTTPS-адрес HTTP-сервера бота: ссылки из сообщений, страница видео, хуки
PUBLIC_URL=https://bot.example.com
HTTP_HOST=127.0.0.1
HTTP_PORT=3025
# Секрет хука оплаты GetCourse: /hooks/gc/payment?secret=...
HOOK_SECRET=
# Telegram id админов бота (/test, /offer, /paid, /stats, /reset) через запятую.
# Тестировщиков можно добавлять в админке: Настройки → «Telegram id тестировщиков».
ADMIN_TG_IDS=
# За каким прокси стоит бот (Express trust proxy): loopback — nginx на этой же машине
TRUST_PROXY=loopback
# 1 — реальные задержки. Меньше 1 сжимает всю воронку, только для прогона
TIME_SCALE=1
